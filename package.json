{
	"name": "sveltekid",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"db:start": "docker compose up",
		"db:push": "drizzle-kit push",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "drizzle-kit migrate",
		"db:studio": "drizzle-kit studio",
		"auth:schema": "npx @better-auth/cli generate --config src/lib/server/auth.ts --output src/lib/server/db/auth.schema.ts --yes"
	},
	"devDependencies": {
		"@eslint/compat": "^2.0.2",
		"@eslint/js": "^9.39.2",
		"@internationalized/date": "^3.12.0",
		"@lucide/svelte": "^1.7.0",
		"@sveltejs/adapter-auto": "^7.0.0",
		"@sveltejs/kit": "^2.50.2",
		"@sveltejs/vite-plugin-svelte": "^6.2.4",
		"@tailwindcss/forms": "^0.5.11",
		"@tailwindcss/typography": "^0.5.19",
		"@tailwindcss/vite": "^4.1.18",
		"@types/node": "^24",
		"better-auth": "^1.4.18",
		"bits-ui": "^2.16.3",
		"drizzle-kit": "^0.31.8",
		"drizzle-orm": "^0.45.1",
		"eslint": "^9.39.2",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.14.0",
		"globals": "^17.3.0",
		"prettier": "^3.8.1",
		"prettier-plugin-svelte": "^3.5.1",
		"prettier-plugin-tailwindcss": "^0.7.2",
		"svelte": "^5.49.2",
		"svelte-check": "^4.3.6",
		"svelte-sonner": "^1.1.0",
		"tailwind-variants": "^3.2.2",
		"tailwindcss": "^4.1.18",
		"tw-animate-css": "^1.4.0",
		"typescript": "^5.9.3",
		"typescript-eslint": "^8.54.0",
		"vaul-svelte": "^1.0.0-next.7",
		"vite": "^7.3.1"
	},
	"dependencies": {
		"@floating-ui/dom": "^1.7.6",
		"@tiptap/core": "^3.20.5",
		"@tiptap/extension-bubble-menu": "^3.20.5",
		"@tiptap/extension-code-block-lowlight": "^3.20.5",
		"@tiptap/extension-floating-menu": "^3.20.4",
		"@tiptap/extension-highlight": "^3.20.5",
		"@tiptap/extension-image": "^3.20.5",
		"@tiptap/extension-list": "^3.20.5",
		"@tiptap/extension-mathematics": "^3.20.5",
		"@tiptap/extension-subscript": "^3.20.5",
		"@tiptap/extension-superscript": "^3.20.5",
		"@tiptap/extension-table": "^3.20.5",
		"@tiptap/extension-table-of-contents": "^3.20.5",
		"@tiptap/extension-text-align": "^3.20.5",
		"@tiptap/extension-text-style": "^3.20.5",
		"@tiptap/extension-typography": "^3.20.5",
		"@tiptap/extensions": "^3.20.5",
		"@tiptap/markdown": "^3.20.5",
		"@tiptap/pm": "^3.20.5",
		"@tiptap/starter-kit": "^3.20.5",
		"@tiptap/suggestion": "^3.20.5",
		"@types/three": "^0.184.0",
		"clsx": "^2.1.1",
		"katex": "^0.16.43",
		"lowlight": "^3.3.0",
		"mode-watcher": "^1.1.0",
		"postgres": "^3.4.8",
		"svelte-tiptap": "^3.0.1",
		"tailwind-merge": "^3.5.0",
		"three": "^0.184.0",
		"tiptap-extension-auto-joiner": "^0.1.3"
	}
}
